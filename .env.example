# Copy to .env and fill in. Never commit .env.

# Groq
GROQ_API_KEY=
GROQ_STT_MODEL=whisper-large-v3
GROQ_LLM_MODEL=openai/gpt-oss-120b
GROQ_TTS_MODEL_AR=canopylabs/orpheus-arabic-saudi
GROQ_TTS_MODEL_EN=canopylabs/orpheus-v1-english
GROQ_TTS_VOICE_AR=aisha
GROQ_TTS_VOICE_EN=hannah

# MCP (hospital systems)
MCP_SERVER_URL=
MCP_AUTH_TOKEN=
MCP_TRANSPORT=streamable_http

# Embeddings (locations)
EMBEDDING_URL=
EMBEDDING_DIM=1024

# Databases
DATABASE_URL=postgresql://user:password@127.0.0.1:5432/hmg_voice_agent
SOURCE_DATABASE_URL=postgresql://user:password@127.0.0.1:5432/ai_agent_patient_appointment

# Tools: live | hybrid (live lookups, simulated patient/auth/writes) | mock
TOOLS_MODE=hybrid
HYBRID_LIVE_AUTH=false
HYBRID_LIVE_BOOKING=false

# Emergency symptoms: advise_and_continue | empathy_only | stop
RED_FLAG_MODE=empathy_only

# Voice
VOICE_END_SILENCE_MS=550
VOICE_BARGE_IN_MS=300

# IVR endpoint /ws/voice-pipeline (see docs/ivr_protocol.md)
AUTH_SECRET=
# AUTH_DATABASE_URL=            # defaults to SOURCE_DATABASE_URL
IVR_INBOUND_RATE=8000
IVR_OUTBOUND_RATE=8000
IVR_CHUNK_MS=300
IVR_AEC=true
IVR_BARGE_IN_GRACE_MS=700
IVR_MIN_SUPPRESSION_RATIO=0.5
IVR_WHITELIST=false
IVR_TRANSFER_DESTINATION=

# Console / operations
# required when TOOLS_MODE=live
CONSOLE_TOKEN=
# server processes (~40–50 concurrent calls each)
WORKERS=1
# transcripts / events / JSONL logs
EVENT_RETENTION_DAYS=90
# patient-data access audit
AUDIT_RETENTION_DAYS=730
ALLOW_INSECURE_LIVE=false
# PROVIDER_OVERRIDE=fake        # load tests / offline dev only

# docker compose
POSTGRES_PASSWORD=
# LLM backup request: no first output after this many seconds → race an identical request (0 = off)
LLM_HEDGE_AFTER_S=2.5

# Platform (Phase 12): agents, providers, MCP servers, tools and skills live in the database (seeded from this repo
# on first start). In development, edits to skills/, config/tools.yaml and the default phrases in
# runtime/harness/prompts.py are imported at start-up as new versions + a new published release.
PLATFORM_REPO_SYNC=true

# Secret store (Phase 12.2): API keys / tokens live encrypted in the database, referenced by name from providers and
# MCP servers (Console → Secrets / Connections). MASTER_KEY encrypts them — generate once, keep a copy safe:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# On first start with MASTER_KEY set, GROQ_API_KEY / MCP_AUTH_TOKEN below (and any key saved from the console) are
# moved into the store; after that the .env copies are only a fallback and can be removed.
MASTER_KEY=
